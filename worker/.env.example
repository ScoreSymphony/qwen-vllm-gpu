# Copy this file to worker/.env on the GPU host and fill in GITHUB_TOKEN.
# Never commit worker/.env.

# Fine-grained GitHub token scoped to ScoreSymphony/ScoreSymphony-Agent-VPS.
# Contents: read/write is sufficient for clone/fetch/push if the task later requires a push.
GITHUB_TOKEN=

TARGET_REPO=https://github.com/ScoreSymphony/ScoreSymphony-Agent-VPS.git
TARGET_BRANCH=main
TARGET_DIR=${HOME}/scoresymphony-workspace/scoresymphony-infrastructure

# Local vLLM endpoint. Qwen Code requires a non-empty OpenAI-compatible API key;
# vLLM itself is not configured to validate this placeholder key.
OPENAI_API_KEY=local-vllm
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_MODEL=Qwen3-Coder-Next-FP8

# Autonomous pilot budget. Override for a different paid GPU window.
QWEN_MAX_WALL_TIME=2h
QWEN_APPROVAL_MODE=yolo

# Local Git identity used for commits created on the GPU worker.
GIT_AUTHOR_NAME=ScoreSymphony
GIT_AUTHOR_EMAIL=scoresymphony@gmail.com
